# ── Server ────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/blogify?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Payments (subscriptions) ──────────────────────
# "mock" = test mode, no real money moves. It is BLOCKED when NODE_ENV=production
# unless ALLOW_MOCK_PAYMENTS=true, because it grants plans for free.
# When Razorpay is wired up (services/payment.js): PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER=mock
# Stripe test mode (PAYMENT_PROVIDER=stripe). Use sk_test_ / pk_test_ keys only.
# Get them at dashboard.stripe.com -> Developers -> API keys (test/sandbox mode).
# STRIPE_SECRET_KEY=sk_test_...        secret: server only, never commit
# STRIPE_PUBLISHABLE_KEY=pk_test_...   public: sent to the browser
# STRIPE_WEBHOOK_SECRET=whsec_...      from `stripe listen --print-secret` (or the dashboard endpoint)
# ALLOW_MOCK_PAYMENTS=true

# Percent of a user-written travel guide's revenue credited to its author (admin-only figure)
# GUIDE_CREATOR_SHARE_PERCENT=50
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
